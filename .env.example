# Backend only. Copy to .env at the project root (recommended), OR server/.env.
# Shell/container variables override files; server/.env overrides root .env.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Local Docker demo credentials only. Use private credentials in production.
# Leave empty for the read-only demo directory without PostgreSQL.
DATABASE_URL=postgresql://healthroute:healthroute@localhost:5432/healthroute

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional: empty uses database-based assistant recommendations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
