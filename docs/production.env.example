# Copy to .env.production at the repository root on EC2. Never commit values.
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_DATABASE_HOST:5432/healthroute?sslmode=verify-full&sslrootcert=/run/database-certs/global-bundle.pem
JWT_SECRET=
CLIENT_URL=https://healthroute.example.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Absolute path; include fullchain.pem and privkey.pem, with real certificate files.
TLS_DIRECTORY=/opt/healthroute/tls
HTTP_PORT=80
HTTPS_PORT=443

# Directory containing the database provider CA bundle (public certificates only).
DATABASE_CERT_DIRECTORY=/opt/healthroute/database-certs
